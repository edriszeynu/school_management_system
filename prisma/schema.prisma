// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------
// ENUMS
// ----------------------------------------------
enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ACCOUNTANT
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HOLIDAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FeeStatus {
  PAID
  PARTIAL
  UNPAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  CHEQUE
}

// ✅ NEW ENUMS (for exams)
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

// ----------------------------------------------
// CORE MODELS
// ----------------------------------------------

// 1. USERS & AUTHENTICATION
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role
  gender        Gender?
  phone         String?
  address       String?
  avatar        String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentStudents  ParentStudent[]
  announcements  Announcement[]
  auditLogs      AuditLog[]

  @@map("users")
}

// 2. ACADEMIC STRUCTURE
model AcademicYear {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes     Class[]
  exams       Exam[]
  feeStructures FeeStructure[]

  @@unique([name])
  @@map("academic_years")
}

model Class {
  id              String          @id @default(cuid())
  name            String
  section         String
  academicYearId  String
  roomNumber      String?
  capacity        Int             @default(30)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  students        StudentProfile[]
  classSubjects   ClassSubject[]
  attendances     Attendance[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  announcements   Announcement[]

  @@unique([name, section, academicYearId])
  @@map("classes")
}

model Subject {
  id            String          @id @default(cuid())
  name          String
  code          String          @unique
  credits       Int             @default(1)
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  classSubjects ClassSubject[]

  @@map("subjects")
}

model ClassSubject {
  id               String    @id @default(cuid())
  classId          String
  subjectId        String
  teacherProfileId String

  class            Class     @relation(fields: [classId], references: [id])
  subject          Subject   @relation(fields: [subjectId], references: [id])
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  timetable        Timetable[]
  grades           Grade[]

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// 3. STUDENT & TEACHER PROFILES
model StudentProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  rollNumber      String?
  dateOfBirth     DateTime
  enrollmentDate  DateTime    @default(now())
  guardianName    String
  guardianContact String
  guardianEmail   String?
  address         String?
  medicalInfo     String?
  classId         String

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  class           Class       @relation(fields: [classId], references: [id])
  parentStudents  ParentStudent[]
  attendances     Attendance[]
  grades          Grade[]
  invoices        Invoice[]
  feeDiscounts    FeeDiscount[]

  // ✅ NEW: exam submissions relation
  examSubmissions ExamSubmission[]

  @@unique([rollNumber, classId])
  @@map("student_profiles")
}

model TeacherProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeId      String?   @unique
  hireDate        DateTime  @default(now())
  qualification   String?
  specialization  String?
  isClassTeacher  Boolean?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSubjects   ClassSubject[]

  @@map("teacher_profiles")
}

// 4. PARENT <-> STUDENT
model ParentStudent {
  id          String   @id @default(cuid())
  parentId    String
  studentId   String
  relation    String

  parent      User     @relation(fields: [parentId], references: [id])
  student     StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@map("parent_students")
}

// 5. TIMETABLE
model Timetable {
  id               String    @id @default(cuid())
  dayOfWeek        String
  period           Int
  classSubjectId   String
  room             String?

  classSubject     ClassSubject @relation(fields: [classSubjectId], references: [id])

  @@unique([dayOfWeek, period, classSubjectId])
  @@map("timetables")
}

// 6. ATTENDANCE
model Attendance {
  id               String           @id @default(cuid())
  studentId        String
  classId          String
  date             DateTime         @default(now())
  status           AttendanceStatus
  remarks          String?

  student          StudentProfile   @relation(fields: [studentId], references: [id])
  class            Class            @relation(fields: [classId], references: [id])

  @@unique([studentId, classId, date])
  @@map("attendances")
}

// 7. EXAMS & GRADES
model Exam {
  id              String     @id @default(cuid())
  title           String
  academicYearId  String
  classId         String?
  startDate       DateTime
  endDate         DateTime
  maxScore        Float
  weightage       Float?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // ✅ NEW fields for online exams
  status          ExamStatus @default(DRAFT)
  duration        Int?       // duration in minutes
  instructions    String?

  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  class           Class?       @relation(fields: [classId], references: [id])
  grades          Grade[]

  // ✅ NEW relations
  questions       Question[]
  submissions     ExamSubmission[]

  @@map("exams")
}

model Grade {
  id               String    @id @default(cuid())
  studentId        String
  classSubjectId   String
  examId           String
  score            Float
  remarks          String?

  student          StudentProfile @relation(fields: [studentId], references: [id])
  classSubject     ClassSubject   @relation(fields: [classSubjectId], references: [id])
  exam             Exam           @relation(fields: [examId], references: [id])

  @@unique([studentId, classSubjectId, examId])
  @@map("grades")
}

// 8. FEES & FINANCIALS
model FeeStructure {
  id              String      @id @default(cuid())
  name            String
  academicYearId  String
  classId         String
  amount          Float
  frequency       String
  dueDay          Int?
  isMandatory     Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  class           Class        @relation(fields: [classId], references: [id])
  invoices        Invoice[]
  discounts       FeeDiscount[]

  @@map("fee_structures")
}

model Invoice {
  id              String      @id @default(cuid())
  invoiceNumber   String      @unique
  studentId       String
  feeStructureId  String
  amount          Float
  dueDate         DateTime
  status          FeeStatus   @default(UNPAID)
  issueDate       DateTime    @default(now())
  paidDate        DateTime?
  lateFee         Float?      @default(0)
  description     String?

  student         StudentProfile @relation(fields: [studentId], references: [id])
  feeStructure    FeeStructure   @relation(fields: [feeStructureId], references: [id])
  payments        Payment[]

  @@map("invoices")
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  amount          Float
  method          PaymentMethod
  transactionId   String?
  paymentDate     DateTime      @default(now())
  receiptNumber   String?       @unique
  notes           String?

  invoice         Invoice       @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model FeeDiscount {
  id              String       @id @default(cuid())
  studentId       String
  feeStructureId  String
  discountPercent Float
  reason          String
  approvedBy      String?
  validFrom       DateTime     @default(now())
  validUntil      DateTime?

  student         StudentProfile @relation(fields: [studentId], references: [id])
  feeStructure    FeeStructure   @relation(fields: [feeStructureId], references: [id])

  @@unique([studentId, feeStructureId])
  @@map("fee_discounts")
}

// 9. COMMUNICATIONS & ANNOUNCEMENTS
model Announcement {
  id              String      @id @default(cuid())
  title           String
  content         String
  targetRole      Role?
  targetClassId   String?
  authorId        String
  isImportant     Boolean     @default(false)
  pinned          Boolean     @default(false)
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  author          User        @relation(fields: [authorId], references: [id])
  class           Class?      @relation(fields: [targetClassId], references: [id])

  @@map("announcements")
}

// 10. AUDIT LOGS
model AuditLog {
  id              String      @id @default(cuid())
  userId          String
  action          String
  entity          String
  entityId        String
  changes         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ----------------------------------------------
// ✅ 11. ONLINE EXAM SYSTEM (NEW)
// ----------------------------------------------

model Question {
  id             String       @id @default(cuid())
  examId         String
  type           QuestionType
  questionText   String
  points         Float        @default(1)
  orderIndex     Int
  correctAnswer  String?      // For TRUE_FALSE ("true"/"false"), SHORT_ANSWER (text); MCQ uses option.isCorrect
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  exam           Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  options        QuestionOption[]
  answers        StudentAnswer[]

  @@map("questions")
}

model QuestionOption {
  id          String   @id @default(cuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  orderIndex  Int

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model ExamSubmission {
  id            String           @id @default(cuid())
  examId        String
  studentId     String
  status        SubmissionStatus @default(IN_PROGRESS)
  startedAt     DateTime         @default(now())
  submittedAt   DateTime?
  totalScore    Float?
  gradedAt      DateTime?

  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers       StudentAnswer[]

  @@unique([examId, studentId])
  @@map("exam_submissions")
}

model StudentAnswer {
  id                String    @id @default(cuid())
  submissionId      String
  questionId        String
  answerText        String?   // For SHORT_ANSWER / ESSAY / TRUE_FALSE ("true" / "false")
  selectedOptionId  String?   // For MULTIPLE_CHOICE
  isCorrect         Boolean?
  pointsEarned      Float?
  gradedAt          DateTime?

  submission        ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question          Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@map("student_answers")
}